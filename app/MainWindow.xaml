<Window x:Class="AzerothCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AzerothCompanion.Controls" Title="Desktop Pixel Companions" Width="1250" Height="870" MinWidth="1050" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#0C111B" Foreground="#EDF0F5" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="DESKTOP PIXEL COMPANIONS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="A familiar voice. A new adventure." FontFamily="Georgia" FontSize="28" Margin="0,8,0,5"/><TextBlock Text="Eight companions · Primary display · Your voices and game" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#192E2B" CornerRadius="10" Padding="12,7"><TextBlock x:Name="SessionBadge" Text="●  CAPTURE OFF · MUTED" Foreground="#B0DAC7" FontSize="11"/></Border></Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10" x:Name="CharacterButtons"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><ScrollViewer x:Name="CharacterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel><TextBlock x:Name="FactionLabel" Text="HORDE" FontSize="11" Foreground="{StaticResource Accent}"/><TextBlock x:Name="NameLabel" Text="Thrall" FontFamily="Georgia" FontSize="27" Margin="0,6,0,2" TextWrapping="Wrap"/><TextBlock x:Name="RoleLabel" Text="The steady mentor" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><local:PortraitControl x:Name="MainPortrait" Height="180"/><StackPanel>
        <TextBlock x:Name="ToneLabel" Text="Calm, thoughtful guidance." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/>
        <CheckBox x:Name="DuoCheck" Content="Two companions" IsChecked="True" Checked="Partner_Changed" Unchecked="Partner_Changed"/>
        <ComboBox x:Name="PartnerPicker" DisplayMemberPath="Name" SelectionChanged="PartnerSelection_Changed"/>
        <TextBlock x:Name="AvatarScaleLabel" Text="Avatar width and height: 25%" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,3"/>
        <Slider x:Name="AvatarScaleSlider" Minimum="15" Maximum="100" Value="25" SmallChange="5" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="AvatarScale_Changed"/>
        <TextBlock Visibility="Collapsed" x:Name="FootprintLabel" Text="Maximum area: 4.0% of the display" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,3"/>
        <Slider Visibility="Collapsed" x:Name="FootprintSlider" Minimum="1.5" Maximum="4.5" Value="4" SmallChange="0.25" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="Footprint_Changed"/>
        <Button Content="Show desktop companions ↗" Click="PopOut_Click" Margin="0,10,0,5"/>
      </StackPanel></StackPanel></ScrollViewer></Border>
      <TabControl Grid.Column="2" Background="#101722" BorderThickness="0">
        <TabItem Header="Companion"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
          <WrapPanel Margin="0,0,0,16">
            <Button x:Name="ToggleCompanionsButton" Click="ToggleCompanions_Click" Margin="0,0,8,0" Padding="12,8" AutomationProperties.Name="Show or hide companions"/>
            <Button x:Name="ReadNowTopButton" Click="ReadNowTop_Click" Margin="0,0,8,0" Padding="12,8" AutomationProperties.Name="Read screen now"/>
            <Button x:Name="ResearchTopButton" Click="ResearchTop_Click" Margin="0,0,8,0" Padding="12,8" AutomationProperties.Name="Research"/>
            <Button x:Name="RepairTopButton" Click="RepairTop_Click" Padding="12,8" AutomationProperties.Name="Repair tools"/>
          </WrapPanel>
          <TextBlock Text="01  READ MY SCREEN" Style="{StaticResource Label}"/>
          <Border Background="#172334" CornerRadius="9" Padding="14" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="Pick a display and your companion reads the text on it aloud - a story in your browser, a document, or a game." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshDisplays_Click"/><ComboBox x:Name="ScreenDisplayPicker" MinWidth="250" AutomationProperties.Name="Display to read"/></DockPanel>
            <WrapPanel Margin="0,8,0,0"><Button x:Name="ScreenReadButton" Content="Read this display now" Background="#335849" Click="ScreenReadNow_Click"/><Button Content="Stop" Click="ScreenStop_Click"/><CheckBox x:Name="ScreenAutoCheck" Content="Auto-read new text" Checked="ScreenAuto_Changed" Unchecked="ScreenAuto_Changed"/><CheckBox x:Name="ScreenSpeakCheck" Content="Speak aloud" IsChecked="True"/></WrapPanel>
            <TextBlock x:Name="ScreenStatusText" Text="Nothing is captured until you press Read. This app's own windows are never included." TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel></Border>
          <TextBlock Text="02  VOICES" Style="{StaticResource Label}"/>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock x:Name="PrimaryVoiceLabel" Text="Primary voice" FontSize="11" Foreground="{StaticResource Muted}"/><ComboBox x:Name="PrimaryVoicePicker" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="VoiceSelection_Changed"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock x:Name="PartnerVoiceLabel" Text="Partner voice" FontSize="11" Foreground="{StaticResource Muted}"/><ComboBox x:Name="PartnerVoicePicker" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="VoiceSelection_Changed"/></StackPanel>
            <Button Grid.Column="2" Content="Refresh voices" Click="RefreshVoices_Click" VerticalAlignment="Bottom" FontSize="11"/>
          </Grid>
          <DockPanel Margin="0,0,0,6"><TextBlock Text="Play voice on" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="AudioOutputPicker" MinWidth="260" SelectionChanged="AudioOutput_Changed" AutomationProperties.Name="Voice output device"/></DockPanel>
          <TextBlock x:Name="VoiceChoicesStatus" Text="Your assigned voices also read game text. Refresh to discover compatible voices." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
          <TextBlock Text="03  ASK YOUR COMPANION" Style="{StaticResource Label}"/>
          <TextBox x:Name="QuestionBox" TextWrapping="Wrap" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ask your companion"/>
          <WrapPanel Margin="0,8,0,0"><Button Content="Ask companion" Background="#6B5534" Click="Ask_Click"/><Button Content="Explain this text" Click="Explain_Click"/></WrapPanel>
          <Border Background="#172334" CornerRadius="9" Padding="15" Margin="0,3,0,10"><StackPanel><TextBlock Text="COMPANION" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,0,6"/><TextBlock x:Name="ReplyText" Text="Choose a game window when you're ready. I can read visible text or help you understand it. Capture and speech stay off until you choose them." FontSize="14" LineHeight="22"/></StackPanel></Border>
          <TextBlock Text="04  QUALITY OF LIFE" Style="{StaticResource Label}" Margin="0,10,0,0"/>
          <StackPanel x:Name="QolPanel" Margin="0,0,0,16"/>
          <Expander Header="Advanced - game windows, microphone and technical options" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"><StackPanel Margin="0,8,0,0">
            <CheckBox x:Name="AdvancedTabsCheck" Content="Show advanced tabs (Research, Character review, Settings)" Checked="AdvancedTabs_Changed" Unchecked="AdvancedTabs_Changed" FontSize="12" Margin="0,0,0,6"/>
            <CheckBox x:Name="ClickThroughCheck" Content="Let clicks pass through companions" Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed" FontSize="11"/>
          <TextBlock Text="GAME WINDOW (ADVANCED)" Style="{StaticResource Label}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshWindows_Click"/><ComboBox x:Name="WindowPicker" DisplayMemberPath="DisplayName" MinWidth="250" SelectionChanged="ProfileWindow_Changed"/></DockPanel>
          <CheckBox x:Name="AutoDetectCheck" Content="Automatically observe verified games on the primary display" IsChecked="True" Checked="AutomaticGames_Changed" Unchecked="AutomaticGames_Changed" FontSize="12" Margin="0,7,0,0"/>
          <TextBlock x:Name="GameIdentityText" Text="Automatic detection uses installed game metadata. Only the primary-display game can be captured; microphone and speech start off." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/>
          <Expander Header="Remember a non-Steam game (explicit local profile)" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"><StackPanel Margin="0,8,0,0">
            <TextBlock Text="Select its running window, enter its public game title, then Remember. The executable path and fingerprint stay local. Automatic research uses only the public title; remembering does not start a session." TextWrapping="Wrap"/>
            <TextBox x:Name="ProfileTitleBox" MaxLength="160" AutomationProperties.Name="Public title for remembered game" Margin="0,6,0,5"/>
            <TextBox x:Name="ProfileExecutableText" IsReadOnly="True" TextWrapping="Wrap" Text="Select an actual game window first." FontSize="11"/>
            <ComboBox x:Name="RememberedGamePicker" DisplayMemberPath="Label" SelectionChanged="RememberedGame_Changed" Margin="0,6,0,0"/>
            <WrapPanel x:Name="ProfileActions"><Button Content="Remember selected game" Click="RememberGame_Click"/><Button Content="Reconfirm profile" Click="ReconfirmGame_Click"/><Button Content="Forget profile" Click="ForgetGame_Click"/><Button Content="Refresh profiles" Click="RefreshRememberedGames_Click"/></WrapPanel>
            <Button Content="Cancel pending confirmation" Click="CancelGameProfile_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ProfileStatusText" Text="No profile is created by selecting a window. Refresh to view existing profiles." TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
          </StackPanel></Expander>
          <WrapPanel><Button x:Name="StartButton" Content="Start selected window" Background="#335849" Click="StartSession_Click"/><Button Content="Stop session" Click="StopSession_Click"/><Button Content="Read once" Click="ReadOnce_Click"/><CheckBox x:Name="AutoReadCheck" Content="Watch text" Checked="Watch_Enabled" Unchecked="Watch_Disabled" Margin="0,9,0,0"/></WrapPanel>
          <Button Content="Text sources &amp; game speaker voices…" Click="TextSources_Click" HorizontalAlignment="Left" FontSize="12"/>
          <TextBlock x:Name="TextSourceStatusText" Text="Game text source: no session" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,5"/>
          <TextBlock x:Name="DialogueQueueStatusText" Text="Narration follows the primary companion voice. No queued speech." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <Expander Header="Dialogue crop (optional, percent of the window)" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"><UniformGrid Columns="4" Margin="0,8,0,0"><StackPanel><TextBlock Text="Left %" Style="{StaticResource Label}"/><TextBox x:Name="RoiX" Text="0" Margin="0,0,7,0"/></StackPanel><StackPanel><TextBlock Text="Top %" Style="{StaticResource Label}"/><TextBox x:Name="RoiY" Text="0" Margin="0,0,7,0"/></StackPanel><StackPanel><TextBlock Text="Width %" Style="{StaticResource Label}"/><TextBox x:Name="RoiW" Text="100" Margin="0,0,7,0"/></StackPanel><StackPanel><TextBlock Text="Height %" Style="{StaticResource Label}"/><TextBox x:Name="RoiH" Text="100"/></StackPanel></UniformGrid></Expander>
          <WrapPanel><ComboBox x:Name="ProcessingPicker" Width="190" SelectedIndex="0" SelectionChanged="Processing_Changed"><ComboBoxItem Content="Local · CPU reasoning"/><ComboBoxItem Content="Hybrid · payment blocked" IsEnabled="False"/></ComboBox><CheckBox x:Name="CloudConsentCheck" Content="Cloud disabled · $0 authorized" IsEnabled="False" Unchecked="Permission_Changed" Margin="0,9,0,0" FontSize="12"/></WrapPanel>
          <WrapPanel><CheckBox x:Name="SpeechCheck" Content="Speak using assigned voices" Checked="Speech_Changed" Unchecked="Speech_Changed"/><CheckBox x:Name="BanterCheck" Content="Proactive conversation" Checked="Watch_Enabled"/><CheckBox x:Name="BusyCheck" Content="Busy / combat: hold banter" IsChecked="True"/></WrapPanel>
          <WrapPanel><CheckBox x:Name="OpenMicCheck" Content="Open mic" Checked="OpenMic_Changed" Unchecked="OpenMic_Changed"/><TextBlock x:Name="MicrophoneStatusText" Text="Mic off · local recognition" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></WrapPanel>
          <TextBlock Text="Open mic listens between replies and pauses while your companions speak. Quiet turns it off. No microphone audio is saved." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
          <WrapPanel><Button x:Name="MicButton" Content="Hold to talk" PreviewMouseLeftButtonDown="Mic_Down" PreviewMouseLeftButtonUp="Mic_Up" LostMouseCapture="Mic_Up"/><Button Content="Quiet / cancel" Click="Quiet_Click"/><CheckBox x:Name="IncludeImageCheck" Content="Include current game image" Checked="Permission_Changed" Unchecked="Permission_Changed" Margin="0,9,0,0" FontSize="12"/></WrapPanel>
          <CheckBox x:Name="SendVoiceCheck" Content="Send recognized speech automatically" IsChecked="True" FontSize="12"/>
          </StackPanel></Expander>
          <Expander Header="Observed text — direct game text / local OCR fallback" Foreground="{StaticResource Muted}" FontSize="12"><TextBox x:Name="ObservedText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="ResearchTab" Visibility="Collapsed" Header="Research"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Explore the world together." FontFamily="Georgia" FontSize="24" Margin="0,0,0,12"/>
          <TextBlock Text="GAME TITLE (CORRECT THE DETECTED NAME IF NEEDED)" Style="{StaticResource Label}"/><TextBox x:Name="GameTitleBox" TextChanged="ResearchScope_Changed" MaxLength="160"/>
          <TextBlock Text="QUEST, CHARACTER, LOCATION OR TOPIC" Style="{StaticResource Label}" Margin="0,12,0,0"/><TextBox x:Name="ResearchTopicBox" TextChanged="ResearchScope_Changed" MaxLength="300"/>
          <CheckBox x:Name="ResearchCheck" Content="Use free public research for this game" Checked="ResearchPermission_Changed" Unchecked="ResearchPermission_Changed" Margin="0,12,0,0"/>
          <CheckBox x:Name="QuestResearchCheck" Content="Use visible quest titles as research topics" Checked="ResearchScope_Changed" Unchecked="ResearchScope_Changed" FontSize="12"/>
          <CheckBox x:Name="QuestionResearchCheck" Content="Research my questions when no topic is entered" IsChecked="True" Checked="ResearchScope_Changed" Unchecked="ResearchScope_Changed" FontSize="12"/>
          <TextBlock Text="Free research sends the public game title and enabled topic to Steam, Wikipedia and public search. It retrieves bounded excerpts and links; detailed guides and current builds may be missing. No screenshot, microphone audio or private game-context notes are sent. Paid providers remain blocked." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10"/>
          <Button Content="Research this topic" Click="ResearchNow_Click" HorizontalAlignment="Left"/>
          <TextBlock x:Name="ResearchStatusText" Text="Free research waits for a detected or selected game" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,12"/>
          <TextBox x:Name="ResearchSummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto"/>
          <StackPanel x:Name="ResearchSources" Margin="0,12,0,0"/>
          <TextBlock Text="Research separates facts from theories and is instructed to respect your spoiler setting. Check linked sources for disputed or patch-sensitive guidance." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="CharacterReviewTab" Visibility="Collapsed" Header="Character review"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Find the voice that fits." FontFamily="Georgia" FontSize="24" Margin="0,0,0,10"/>
          <TextBlock Text="Review source excerpts, installed voice status and optional saved auditions. Nothing plays automatically." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
          <StackPanel x:Name="AuditionRows"/>
          <TextBlock Text="The selected audition transcript appears below." Style="{StaticResource Label}" Margin="0,12,0,0"/>
          <TextBox x:Name="AuditionScript" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto"/>
          <Button Content="Open audition folder" Click="OpenAuditions_Click" Margin="0,12,0,8" HorizontalAlignment="Left"/>
          <TextBlock Text="Portrait animation uses illustrated expression frames. Voice matching and subjective quality require listening review." Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="SettingsTab" Visibility="Collapsed" Header="Settings &amp; checks"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Your game. Your boundaries." FontFamily="Georgia" FontSize="24" Margin="0,0,0,15"/>
          <TextBlock Text="GAME / PATCH / CLASS / PROGRESS" Style="{StaticResource Label}"/>
          <TextBox x:Name="GameContextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="110" MaxLength="400" TextChanged="ResearchScope_Changed"/>
          <CheckBox x:Name="SpoilersCheck" Content="Allow story spoilers" Margin="0,12,0,0" Checked="ResearchScope_Changed" Unchecked="ResearchScope_Changed"/>
          <Button Content="Save these preferences locally" Click="SavePreferences_Click" HorizontalAlignment="Left" Margin="0,10,0,16"/>
          <TextBlock Text="SERVICE CHECKS" Style="{StaticResource Label}"/><Button Content="Check existing services" Click="CheckServices_Click" HorizontalAlignment="Left"/><TextBlock x:Name="DiagnosticsText" Text="No models or services have been started by this app." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
          <TextBlock Text="SPENDING AUTHORIZATION" Style="{StaticResource Label}"/><TextBlock x:Name="BudgetText" Text="Paid services blocked · $0 authorized" Margin="0,0,0,7"/><TextBlock Text="The former $25 ceiling does not grant permission to spend. Existing accounting is preserved, but paid reasoning and search are blocked independently of keys and sharing settings." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
          <TextBlock Text="PERFORMANCE COMPARISON" Style="{StaticResource Label}"/><TextBlock Text="Compare identical prompts in Local and Hybrid modes. Timing records omit screenshots and conversation content. FPS and OCR accuracy require real WoW playtesting." Foreground="{StaticResource Muted}" FontSize="12"/><Button Content="Open local diagnostics folder" Click="OpenState_Click" HorizontalAlignment="Left" Margin="0,12,0,16"/>
          <TextBlock Text="HOTKEYS" Style="{StaticResource Label}"/><TextBlock Text="Ctrl+Shift+F10: read once   ·   Hold Ctrl+Shift+F11: talk&#10;Ctrl+Shift+F12: quiet/cancel&#10;F20 and your existing narration controls are untouched." Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready · Session off · No screen or microphone recording" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,15,0,0"/>
  </Grid>
</Window>


