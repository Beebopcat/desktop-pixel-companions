<UserControl x:Class="AzerothCompanion.Controls.PortraitControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="Stage" ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="Portrait" Stretch="Uniform" Margin="6,0,6,0" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"><Image.RenderTransform><TransformGroup><ScaleTransform x:Name="Breath"/><RotateTransform x:Name="Tilt"/><TranslateTransform x:Name="BodyMotion"/><TranslateTransform x:Name="FrameAlignment"/></TransformGroup></Image.RenderTransform></Image>
    <Canvas x:Name="PropLayer" IsHitTestVisible="False" ClipToBounds="True"><Image x:Name="PropImage" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor"><Image.RenderTransform><TransformGroup><ScaleTransform x:Name="PropMirror"/><RotateTransform x:Name="PropRotation"/></TransformGroup></Image.RenderTransform></Image></Canvas>
    <TextBlock x:Name="Fallback" Text="AVATAR ARTWORK PENDING" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#8D9BB0" FontSize="12" Margin="8"/>
    <Border Grid.Row="1" x:Name="ActivityBadge" HorizontalAlignment="Center" Background="#D0121925" CornerRadius="10" Padding="12,5" Margin="8,0,8,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ActivityDot" Width="6" Height="6" Fill="#A4AEBD" Margin="0,0,7,0"/><TextBlock x:Name="ActivityText" Text="Ready when you are" FontSize="11" Foreground="#C5CEDA"/></StackPanel></Border>
  </Grid>
</UserControl>
